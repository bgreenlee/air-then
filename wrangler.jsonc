{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clear-skies-aqi",
  "compatibility_date": "2026-05-22",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d4688e603e0746d39589b5c382744c0f"
    }
  ]
}
